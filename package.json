{
  "name": "mypageseo",
  "version": "1.0.0",
  "description": "My Page Seo a SEO tool that cover all",
  "main": "index.js",
  "scripts": {
    "start": "pm2 start ecosystem.config.json --no-daemon",
    "dev": "cross-env NODE_ENV=development nodemon",
    "build": "tsc -p . && shx cp package.json ./build/package.json && shx cp package-lock.json ./build/package-lock.json && shx cp .env ./build/.env",
    "lint": "eslint src/**/*.ts",
    "lint-fix": "eslint --fix src/**/*.ts",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "precommit": "npm run lint-fix && npm run format",
    "prepush": "npm run lint",
    "mongo-migrate": "cross-env NODE_ENV=development ts-node ./src/configs/mongoMigrate.ts",
    "seed-country-city-state": "cross-env NODE_ENV=development ts-node ./src/configs/fetchCountryStateCityDataFromRemoteApi.ts"
  },
  "keywords": [
    "Node",
    "Typescript",
    "MongoDb",
    "Boilerplate",
    "Setup"
  ],
  "author": "mypageseo",
  "license": "ISC",
  "dependencies": {
    "@paypal/checkout-server-sdk": "^1.0.3",
    "axios": "^1.7.2",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "fs-extra": "^11.2.0",
    "google-auth-library": "^9.13.0",
    "googleapis": "^140.0.1",
    "helmet": "^7.1.0",
    "http-proxy-middleware": "^3.0.0",
    "http-status": "^1.7.4",
    "http-status-codes": "^2.3.0",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "moment": "^2.30.1",
    "moment-timezone": "^0.5.45",
    "mongoose": "^8.4.4",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.10.1",
    "node-cache": "^5.1.2",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.9.14",
    "password-validator": "^5.3.0",
    "pm2": "^5.4.1",
    "randomatic": "^3.1.1",
    "razorpay": "^2.9.6",
    "request-ip": "^3.3.0",
    "sequelize": "^6.37.3",
    "sharp": "^0.33.2",
    "slugify": "^1.6.6",
    "swagger-ui-express": "^5.0.1",
    "validator": "^13.12.0",
    "winston": "^3.13.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.5.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/eslint__js": "^8.42.3",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.14.6",
    "@types/node-cron": "^3.0.11",
    "@types/randomatic": "^3.1.5",
    "@types/request-ip": "^0.0.41",
    "@types/swagger-ui-express": "^4.1.6",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-jest": "^28.6.0",
    "husky": "^9.0.11",
    "nodemon": "^3.1.4",
    "prettier": "^3.3.2",
    "shx": "^0.3.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.2",
    "typescript-eslint": "^7.13.1"
  }
}
